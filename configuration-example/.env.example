# Optional: choose a non-default configuration file.
GESTALTX_CONFIG=gestaltx.config.yaml

# ollama (default) or openrouter
GESTALTX_LLM_PROVIDER=ollama

# Required only when using OpenRouter.
# Never commit a real key. Keep this file as the template; copy to .env (gitignored).
# If a key ever leaks in chat, screenshot, or Git history: revoke it and create a new one.
OPENROUTER_API_KEY=
